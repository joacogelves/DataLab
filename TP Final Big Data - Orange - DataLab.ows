		<properties node_id="23" format="literal">{'auto_apply': True, 'class_weight': False, 'controlAreaVisible': True, 'index_output': 0, 'learner_name': '', 'max_depth': 3, 'max_features': 5, 'min_samples_split': 5, 'n_estimators': 100, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\xf0\x00\x00\x00\xc7\x00\x00\x03h\x00\x00\x02)\x00\x00\x01\xf1\x00\x00\x00\xe6\x00\x00\x03g\x00\x00\x02(\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x01\xf1\x00\x00\x00\xe6\x00\x00\x03g\x00\x00\x02(', 'use_max_depth': False, 'use_max_features': False, 'use_min_samples_split': True, 'use_random_state': False, '__version__': 1}</properties>
		<properties node_id="24" format="literal">{'compatibility_mode': False, 'controlAreaVisible': True, 'number_of_folds': 10, 'replacement': False, 'sampleSizeNumber': 1, 'sampleSizePercentage': 80, 'sampleSizeSqlPercentage': 0.1, 'sampleSizeSqlTime': 1, 'sampling_type': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x04\x18\x00\x00\x00\x90\x00\x00\x05\x00\x00\x00\x02@\x00\x00\x04\x19\x00\x00\x00\xaf\x00\x00\x04\xff\x00\x00\x02?\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x04\x19\x00\x00\x00\xaf\x00\x00\x04\xff\x00\x00\x02?', 'selectedFold': 1, 'sql_dl': False, 'stratify': True, 'use_seed': True, '__version__': 2}</properties>
		<properties node_id="25" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x05V\x00\x00\x02\xd0\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05U\x00\x00\x02\xcf\x00\x00\x00\x00\x02\x00\x00\x00\x05V\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05U\x00\x00\x02\xcf', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import Table\n\n# === CONFIGURACIÓN ===\nTARGET_MINORITY_RATIO = 0.40  # 40% para la clase minoritaria (fraude)\n# Si quisieras 50/50 usás 0.50, si 70/30 usás 0.30, etc.\n\n# Tomamos el dataset de entrada\ndata = in_data\n\nif data is None or data.domain.class_var is None:\n    out_data = data\nelse:\n    # Convertimos a arrays de NumPy\n    X = data.X\n    y = data.Y\n    M = data.metas\n    \n    # Identificamos clases\n    classes, counts = np.unique(y, return_counts=True)\n    print(f"Clases originales: {dict(zip(classes, counts))}")\n    \n    # Mayoritaria y minoritaria\n    majority_class = classes[np.argmax(counts)]\n    minority_class = classes[np.argmin(counts)]\n    n_majority = counts.max()\n    n_minority = counts.min()\n    \n    # === CÁLCULO 60/40 ===\n    # Queremos que la minoritaria sea TARGET_MINORITY_RATIO del total.\n    # Mantenemos fija la mayoritaria. Si N_total = N_majority / (1 - TARGET_MINORITY_RATIO),\n    # entonces N_minority_target = N_total * TARGET_MINORITY_RATIO\n    n_total_target = int(n_majority / (1 - TARGET_MINORITY_RATIO))\n    n_minority_target = int(n_total_target * TARGET_MINORITY_RATIO)\n    n_to_generate = n_minority_target - n_minority\n    \n    print(f"Clase mayoritaria: {majority_class} ({n_majority} casos) - se mantiene")\n    print(f"Clase minoritaria: {minority_class} ({n_minority} casos) - se llevará a {n_minority_target}")\n    print(f"Ratio objetivo: {(1-TARGET_MINORITY_RATIO)*100:.0f}/{TARGET_MINORITY_RATIO*100:.0f}")\n    print(f"Casos sintéticos a generar: {n_to_generate}")\n    \n    if n_to_generate &lt;= 0:\n        print("No hace falta generar casos sintéticos.")\n        out_data = data\n    else:\n        # SMOTE manual: K-vecinos cercanos + interpolación\n        X_minority = X[y == minority_class]\n        \n        k = 5\n        n_minority_total = len(X_minority)\n        \n        np.random.seed(42)\n        \n        from scipy.spatial.distance import cdist\n        distances = cdist(X_minority, X_minority)\n        neighbors_idx = np.argsort(distances, axis=1)[:, 1:k+1]\n        \n        synthetic_X = np.zeros((n_to_generate, X.shape[1]))\n        \n        for i in range(n_to_generate):\n            idx_base = np.random.randint(n_minority_total)\n            base_point = X_minority[idx_base]\n            idx_neighbor = neighbors_idx[idx_base][np.random.randint(k)]\n            neighbor_point = X_minority[idx_neighbor]\n            alpha = np.random.random()\n            synthetic_X[i] = base_point + alpha * (neighbor_point - base_point)\n        \n        # Etiquetas: todos clase minoritaria\n        synthetic_y = np.full(n_to_generate, minority_class)\n        \n        # Metas: identificadores ficticios para los sintéticos\n        n_metas = M.shape[1] if M.ndim &gt; 1 else 1\n        synthetic_M = np.array(\n            [[f"SYNTH_{i:05d}"] * n_metas for i in range(n_to_generate)],\n            dtype=object\n        )\n        \n        # Combinamos\n        new_X = np.vstack([X, synthetic_X])\n        new_y = np.concatenate([y, synthetic_y])\n        new_M = np.vstack([M, synthetic_M])\n        \n        # Verificación final\n        new_classes, new_counts = np.unique(new_y, return_counts=True)\n        new_total = len(new_X)\n        print(f"\\n=== RESULTADO FINAL ===")\n        print(f"Clases después de SMOTE: {dict(zip(new_classes, new_counts))}")\n        print(f"Total de filas: {new_total}")\n        print(f"Ratio real: {new_counts[0]/new_total*100:.1f}% clase 0 / {new_counts[1]/new_total*100:.1f}% clase 1")\n        \n        out_data = Table.from_numpy(data.domain, new_X, new_y, new_M)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
